# nginx ignition configuration
#
# This file was generated by the nginx ignition installer. The keys listed below
# are managed by the installer and may be updated when you upgrade. You can add
# your own keys at the end of the file; they are preserved during upgrades.
#
# Configuration can also be provided through environment variables. See
# https://github.com/lucasdillmann/nginx-ignition/blob/main/docs/configuration-properties.md

# HTTP server
nginx-ignition.server.address=@SERVER_ADDRESS@
nginx-ignition.server.port=@SERVER_PORT@
nginx-ignition.server.read-timeout-seconds=15
nginx-ignition.server.write-timeout-seconds=30
nginx-ignition.server.idle-timeout-seconds=120
nginx-ignition.server.read-header-timeout-seconds=2
nginx-ignition.server.max-header-bytes=16384
nginx-ignition.server.max-body-bytes=10485760

# nginx
nginx-ignition.nginx.binary-path=@NGINX_BINARY_PATH@
nginx-ignition.nginx.config-path=@NGINX_CONFIG_PATH@

# VPNs
nginx-ignition.vpn.config-path=@VPN_CONFIG_PATH@

# Embedded SQLite database
nginx-ignition.database.driver=sqlite
nginx-ignition.database.data-path=@DATA_PATH@
nginx-ignition.database.sqlite.busy-timeout-ms=5000

