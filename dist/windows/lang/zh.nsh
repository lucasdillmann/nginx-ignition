; Simplified Chinese strings for the nginx ignition installer.

LangString NI_NAME ${LANG_SIMPCHINESE} "nginx ignition"

; Group box labels
LangString NI_GROUP_WEB ${LANG_SIMPCHINESE} "Web 界面"
LangString NI_GROUP_DATA ${LANG_SIMPCHINESE} "数据"
LangString NI_GROUP_NGINX ${LANG_SIMPCHINESE} "nginx"
LangString NI_GROUP_VPN ${LANG_SIMPCHINESE} "VPN"
LangString NI_GROUP_POSTGRES ${LANG_SIMPCHINESE} "PostgreSQL 连接"
LangString NI_GROUP_FIREWALL ${LANG_SIMPCHINESE} "Windows 防火墙"
LangString NI_GROUP_SHORTCUTS ${LANG_SIMPCHINESE} "快捷方式"
LangString NI_WELCOME_TITLE ${LANG_SIMPCHINESE} "欢迎安装 nginx ignition"
LangString NI_WELCOME_TEXT ${LANG_SIMPCHINESE} "此向导将安装 nginx ignition 并将其注册为 Windows 服务。$\r$\n$\r$\nnginx ignition 是用于管理 nginx Web 服务器的现代 Web 界面。nginx 不包含在内，必须单独安装。$\r$\n$\r$\n单击“下一步”继续。"
LangString NI_VERSION_LABEL ${LANG_SIMPCHINESE} "版本"
LangString NI_FINISH_TITLE ${LANG_SIMPCHINESE} "安装完成"
LangString NI_FINISH_TEXT ${LANG_SIMPCHINESE} "nginx ignition 已成功安装。请打开 Web 界面，创建第一个用户并完成设置。"
LangString NI_FINISH_RUN ${LANG_SIMPCHINESE} "打开 nginx ignition"
LangString NI_FINISH_LINK ${LANG_SIMPCHINESE} "项目网站"
LangString NI_INSTALLTYPE_TITLE ${LANG_SIMPCHINESE} "安装类型"
LangString NI_INSTALLTYPE_SUBTITLE ${LANG_SIMPCHINESE} "选择您希望如何配置 nginx ignition。"
LangString NI_INSTALLTYPE_EXPRESS ${LANG_SIMPCHINESE} "快速（推荐）"
LangString NI_INSTALLTYPE_EXPRESS_DESC ${LANG_SIMPCHINESE} "使用检测到的 nginx 安装，监听 127.0.0.1:8090，并使用内置 SQLite 数据库（推荐用于测试）和 LocalSystem 帐户。"
LangString NI_INSTALLTYPE_ADVANCED ${LANG_SIMPCHINESE} "高级"
LangString NI_INSTALLTYPE_ADVANCED_DESC ${LANG_SIMPCHINESE} "允许配置 nginx、服务器端口、数据库、服务帐户和防火墙规则。"
LangString NI_NGINX_TITLE ${LANG_SIMPCHINESE} "nginx 配置"
LangString NI_NGINX_SUBTITLE ${LANG_SIMPCHINESE} "指定 nginx 的安装位置以及 nginx ignition 应写入其配置的位置。"
LangString NI_NGINX_PATH ${LANG_SIMPCHINESE} "nginx.exe 路径："
LangString NI_BROWSE ${LANG_SIMPCHINESE} "浏览..."
LangString NI_FILE_FILTER ${LANG_SIMPCHINESE} "可执行文件 (*.exe)|*.exe|所有文件 (*.*)|*.*"
LangString NI_NGINX_CONFIG_DIR ${LANG_SIMPCHINESE} "受管理的 nginx 配置目录："
LangString NI_VPN_CONFIG_DIR ${LANG_SIMPCHINESE} "VPN 配置目录："
LangString NI_NGINX_HINT ${LANG_SIMPCHINESE} "nginx.exe 路径必须是绝对路径，以便 Windows 服务能够找到它。"
LangString NI_NGINX_NOT_FOUND ${LANG_SIMPCHINESE} "在所选路径中未找到 nginx.exe。仍可安装 nginx ignition，但在启动服务之前，必须在配置文件中设置有效路径。$\r$\n$\r$\n仍要继续吗？"
LangString NI_SERVER_TITLE ${LANG_SIMPCHINESE} "服务器和数据"
LangString NI_SERVER_SUBTITLE ${LANG_SIMPCHINESE} "配置 Web 界面使用的地址和端口以及数据存储位置。"
LangString NI_SERVER_ADDRESS ${LANG_SIMPCHINESE} "监听地址："
LangString NI_SERVER_PORT ${LANG_SIMPCHINESE} "HTTP 端口："
LangString NI_SERVER_HINT ${LANG_SIMPCHINESE} "使用 127.0.0.1 仅接受本地连接，使用 0.0.0.0 将 Web 界面开放到网络。"
LangString NI_DATA_DIR ${LANG_SIMPCHINESE} "数据目录："
LangString NI_INVALID_PORT ${LANG_SIMPCHINESE} "端口必须是 1 到 65535 之间的数字。"
LangString NI_DATABASE_TITLE ${LANG_SIMPCHINESE} "数据库"
LangString NI_DATABASE_SUBTITLE ${LANG_SIMPCHINESE} "选择 nginx ignition 使用的数据库。"
LangString NI_DB_SQLITE ${LANG_SIMPCHINESE} "内置 SQLite（推荐用于测试）"
LangString NI_DB_POSTGRES ${LANG_SIMPCHINESE} "PostgreSQL（推荐用于生产环境）"
LangString NI_DB_HOST ${LANG_SIMPCHINESE} "主机："
LangString NI_DB_PORT ${LANG_SIMPCHINESE} "端口："
LangString NI_DB_NAME ${LANG_SIMPCHINESE} "数据库名称："
LangString NI_DB_SCHEMA ${LANG_SIMPCHINESE} "架构："
LangString NI_DB_USER ${LANG_SIMPCHINESE} "用户名："
LangString NI_DB_PASSWORD ${LANG_SIMPCHINESE} "密码："
LangString NI_DB_SSLMODE ${LANG_SIMPCHINESE} "SSL 模式："
LangString NI_DB_SSL_DISABLE ${LANG_SIMPCHINESE} "禁用"
LangString NI_DB_SSL_REQUIRE ${LANG_SIMPCHINESE} "要求"
LangString NI_DB_REQUIRED ${LANG_SIMPCHINESE} "PostgreSQL 需要主机、数据库名称、用户名和密码。"
LangString NI_DB_CHANGE_WARNING ${LANG_SIMPCHINESE} "您正在更改现有安装的数据库驱动程序。数据不会自动迁移。$\r$\n$\r$\n继续吗？"
LangString NI_SERVICE_TITLE ${LANG_SIMPCHINESE} "Windows 服务"
LangString NI_SERVICE_SUBTITLE ${LANG_SIMPCHINESE} "选择 nginx ignition 服务使用的帐户和启动模式。"
LangString NI_SERVICE_ACCOUNT ${LANG_SIMPCHINESE} "服务帐户"
LangString NI_SERVICE_LOCALSYSTEM ${LANG_SIMPCHINESE} "LocalSystem（推荐）"
LangString NI_SERVICE_NETWORKSERVICE ${LANG_SIMPCHINESE} "网络服务"
LangString NI_SERVICE_LOCALSERVICE ${LANG_SIMPCHINESE} "本地服务"
LangString NI_SERVICE_CUSTOM ${LANG_SIMPCHINESE} "自定义帐户"
LangString NI_SERVICE_USER ${LANG_SIMPCHINESE} "帐户名称："
LangString NI_SERVICE_PASSWORD ${LANG_SIMPCHINESE} "密码："
LangString NI_SERVICE_PASSWORD_CONFIRM ${LANG_SIMPCHINESE} "确认密码："
LangString NI_SERVICE_STARTTYPE ${LANG_SIMPCHINESE} "启动类型"
LangString NI_SERVICE_AUTO ${LANG_SIMPCHINESE} "自动"
LangString NI_SERVICE_MANUAL ${LANG_SIMPCHINESE} "手动"
LangString NI_SERVICE_START_NOW ${LANG_SIMPCHINESE} "安装后启动服务"
LangString NI_SERVICE_CUSTOM_REQUIRED ${LANG_SIMPCHINESE} "请输入自定义服务帐户的帐户名称和密码。"
LangString NI_SERVICE_CUSTOM_SUBTITLE ${LANG_SIMPCHINESE} "输入将运行 nginx ignition 服务的帐户凭据。"
LangString NI_SERVICE_CUSTOM_HINT ${LANG_SIMPCHINESE} "安装程序会尽可能为此帐户授予“作为服务登录”权限。如果服务无法启动，请检查 Windows 事件日志。"
LangString NI_SERVICE_PASSWORD_MISMATCH ${LANG_SIMPCHINESE} "密码不匹配。"
LangString NI_SERVICE_CREATE_FAILED ${LANG_SIMPCHINESE} "无法创建 nginx ignition 服务。请检查帐户名称和密码，然后重新运行安装程序。$\r$\n$\r$\n详细信息："
LangString NI_SERVICE_START_FAILED ${LANG_SIMPCHINESE} "服务已安装，但无法启动。请查看 Windows 事件日志以获取详细信息。"
LangString NI_SERVICE_DESCRIPTION ${LANG_SIMPCHINESE} "提供 nginx ignition Web 界面并管理 nginx。"
LangString NI_FIREWALL_TITLE ${LANG_SIMPCHINESE} "防火墙和快捷方式"
LangString NI_FIREWALL_SUBTITLE ${LANG_SIMPCHINESE} "选择要创建的 Windows 防火墙规则和快捷方式。"
LangString NI_FIREWALL_UI ${LANG_SIMPCHINESE} "允许 Web 界面端口（域和专用网络）"
LangString NI_FIREWALL_HTTP ${LANG_SIMPCHINESE} "允许 HTTP 端口 80"
LangString NI_FIREWALL_HTTPS ${LANG_SIMPCHINESE} "允许 HTTPS 端口 443"
LangString NI_DESKTOP_SHORTCUT ${LANG_SIMPCHINESE} "创建指向 Web 界面的桌面快捷方式"
LangString NI_STARTMENU_SHORTCUT ${LANG_SIMPCHINESE} "创建指向 Web 界面的开始菜单快捷方式"
LangString NI_SECTION_APP ${LANG_SIMPCHINESE} "nginx ignition"
LangString NI_SHORTCUT_NAME ${LANG_SIMPCHINESE} "nginx ignition"
LangString NI_UNINSTALL_SHORTCUT ${LANG_SIMPCHINESE} "卸载 nginx ignition"
LangString NI_UNINSTALL_OPTIONS_TITLE ${LANG_SIMPCHINESE} "卸载选项"
LangString NI_UNINSTALL_OPTIONS_SUBTITLE ${LANG_SIMPCHINESE} "选择要从此计算机中删除的内容。"
LangString NI_UNINSTALL_PURGE_CHECKBOX ${LANG_SIMPCHINESE} "删除 C:\ProgramData\nginx-ignition 中的配置和数据"
LangString NI_UNINSTALL_PURGE_HINT ${LANG_SIMPCHINESE} "保持未选中状态，以便为将来的安装保留配置和数据库。"
LangString NI_UNINSTALL_KEEP_DATA ${LANG_SIMPCHINESE} "保留 C:\ProgramData\nginx-ignition 中的配置和数据。"
LangString NI_UPGRADE_TEXT ${LANG_SIMPCHINESE} "检测到现有的 nginx ignition 安装。升级期间将停止服务。配置和数据将被保留。"
LangString NI_ERR_ARCH_X64 ${LANG_SIMPCHINESE} "此安装程序需要 64 位版本的 Windows。"
LangString NI_ERR_ARCH_ARM64 ${LANG_SIMPCHINESE} "此安装程序需要 ARM64 上的 Windows。"
LangString NI_ERR_ARCH_MISMATCH ${LANG_SIMPCHINESE} "此安装程序不支持此处理器架构。请从发布页面下载与您的架构匹配的安装程序。"
LangString NI_ERR_WINVER ${LANG_SIMPCHINESE} "nginx ignition 需要 Windows 10 或 Windows Server 2016 或更高版本。"
LangString NI_ERR_CONFIG ${LANG_SIMPCHINESE} "无法写入配置文件。请检查 C:\ProgramData\nginx-ignition 的权限，然后重试。"
LangString NI_ERR_SERVICE_DELETE ${LANG_SIMPCHINESE} "无法停止或删除现有的 nginx ignition 服务。请手动停止它，然后重新运行安装程序。"
LangString NI_ERR_DIR ${LANG_SIMPCHINESE} "无法创建安装目录。"
LangString NI_ERR_FIREWALL ${LANG_SIMPCHINESE} "无法创建某些 Windows 防火墙规则。您可以稍后手动添加它们。"
LangString NI_CONFIG_IMPORT_FAILED ${LANG_SIMPCHINESE} "无法复制通过 /CONFIG 指定的配置文件。请检查文件是否存在，然后重试。"
LangString NI_DETAIL_STOP ${LANG_SIMPCHINESE} "正在停止现有服务..."
LangString NI_DETAIL_CONFIG ${LANG_SIMPCHINESE} "正在写入配置文件..."
LangString NI_DETAIL_ACL ${LANG_SIMPCHINESE} "正在设置文件权限..."
LangString NI_DETAIL_EVENTLOG ${LANG_SIMPCHINESE} "正在注册事件日志源..."
LangString NI_DETAIL_SERVICE ${LANG_SIMPCHINESE} "正在配置 Windows 服务..."
LangString NI_DETAIL_FIREWALL ${LANG_SIMPCHINESE} "正在配置 Windows 防火墙..."
LangString NI_DETAIL_SHORTCUTS ${LANG_SIMPCHINESE} "正在创建快捷方式..."
LangString NI_DETAIL_START ${LANG_SIMPCHINESE} "正在启动 nginx ignition 服务..."
LangString NI_DETAIL_UNINSTALL ${LANG_SIMPCHINESE} "正在删除 nginx ignition..."
