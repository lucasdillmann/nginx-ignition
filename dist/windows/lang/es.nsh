; Spanish strings for the nginx ignition installer.

LangString NI_NAME ${LANG_SPANISHINTERNATIONAL} "nginx ignition"

; Group box labels
LangString NI_GROUP_WEB ${LANG_SPANISHINTERNATIONAL} "Interfaz web"
LangString NI_GROUP_DATA ${LANG_SPANISHINTERNATIONAL} "Datos"
LangString NI_GROUP_NGINX ${LANG_SPANISHINTERNATIONAL} "nginx"
LangString NI_GROUP_VPN ${LANG_SPANISHINTERNATIONAL} "VPN"
LangString NI_GROUP_POSTGRES ${LANG_SPANISHINTERNATIONAL} "Conexión PostgreSQL"
LangString NI_GROUP_FIREWALL ${LANG_SPANISHINTERNATIONAL} "Firewall de Windows"
LangString NI_GROUP_SHORTCUTS ${LANG_SPANISHINTERNATIONAL} "Accesos directos"
LangString NI_WELCOME_TITLE ${LANG_SPANISHINTERNATIONAL} "Bienvenido a la instalación de nginx ignition"
LangString NI_WELCOME_TEXT ${LANG_SPANISHINTERNATIONAL} "Este asistente instalará nginx ignition y lo registrará como un servicio de Windows.$\r$\n$\r$\nnginx ignition es una interfaz web moderna para administrar el servidor web nginx. nginx no está incluido y debe instalarse por separado.$\r$\n$\r$\nHaga clic en Siguiente para continuar."
LangString NI_VERSION_LABEL ${LANG_SPANISHINTERNATIONAL} "Versión"
LangString NI_FINISH_TITLE ${LANG_SPANISHINTERNATIONAL} "Instalación completada"
LangString NI_FINISH_TEXT ${LANG_SPANISHINTERNATIONAL} "nginx ignition se ha instalado correctamente. Abra la interfaz web para crear su primer usuario y finalizar la configuración."
LangString NI_FINISH_RUN ${LANG_SPANISHINTERNATIONAL} "Abrir nginx ignition"
LangString NI_FINISH_LINK ${LANG_SPANISHINTERNATIONAL} "Sitio web del proyecto"
LangString NI_INSTALLTYPE_TITLE ${LANG_SPANISHINTERNATIONAL} "Tipo de instalación"
LangString NI_INSTALLTYPE_SUBTITLE ${LANG_SPANISHINTERNATIONAL} "Elija cómo desea configurar nginx ignition."
LangString NI_INSTALLTYPE_EXPRESS ${LANG_SPANISHINTERNATIONAL} "Express (recomendada)"
LangString NI_INSTALLTYPE_EXPRESS_DESC ${LANG_SPANISHINTERNATIONAL} "Usa la instalación de nginx detectada, escucha en 127.0.0.1:8090 y utiliza la base de datos SQLite integrada (recomendada para pruebas) con la cuenta LocalSystem."
LangString NI_INSTALLTYPE_ADVANCED ${LANG_SPANISHINTERNATIONAL} "Avanzada"
LangString NI_INSTALLTYPE_ADVANCED_DESC ${LANG_SPANISHINTERNATIONAL} "Permite configurar nginx, los puertos del servidor, la base de datos, la cuenta del servicio y las reglas del firewall."
LangString NI_NGINX_TITLE ${LANG_SPANISHINTERNATIONAL} "Configuración de nginx"
LangString NI_NGINX_SUBTITLE ${LANG_SPANISHINTERNATIONAL} "Indique dónde está instalado nginx y dónde debe escribir nginx ignition su configuración."
LangString NI_NGINX_PATH ${LANG_SPANISHINTERNATIONAL} "Ruta de nginx.exe:"
LangString NI_BROWSE ${LANG_SPANISHINTERNATIONAL} "Examinar..."
LangString NI_FILE_FILTER ${LANG_SPANISHINTERNATIONAL} "Ejecutables (*.exe)|*.exe|Todos los archivos (*.*)|*.*"
LangString NI_NGINX_CONFIG_DIR ${LANG_SPANISHINTERNATIONAL} "Directorio de configuración administrada de nginx:"
LangString NI_VPN_CONFIG_DIR ${LANG_SPANISHINTERNATIONAL} "Directorio de configuración de VPN:"
LangString NI_NGINX_HINT ${LANG_SPANISHINTERNATIONAL} "La ruta de nginx.exe debe ser absoluta para que el servicio de Windows pueda encontrarla."
LangString NI_NGINX_NOT_FOUND ${LANG_SPANISHINTERNATIONAL} "No se encontró nginx.exe en la ruta seleccionada. nginx ignition aún se puede instalar, pero debe establecer una ruta válida en el archivo de configuración antes de iniciar el servicio.$\r$\n$\r$\n¿Continuar de todos modos?"
LangString NI_SERVER_TITLE ${LANG_SPANISHINTERNATIONAL} "Servidor y datos"
LangString NI_SERVER_SUBTITLE ${LANG_SPANISHINTERNATIONAL} "Configure la dirección y el puerto utilizados por la interfaz web y dónde se almacenan los datos."
LangString NI_SERVER_ADDRESS ${LANG_SPANISHINTERNATIONAL} "Dirección de escucha:"
LangString NI_SERVER_PORT ${LANG_SPANISHINTERNATIONAL} "Puerto HTTP:"
LangString NI_SERVER_HINT ${LANG_SPANISHINTERNATIONAL} "Use 127.0.0.1 para aceptar solo conexiones locales, o 0.0.0.0 para exponer la interfaz web en la red."
LangString NI_DATA_DIR ${LANG_SPANISHINTERNATIONAL} "Directorio de datos:"
LangString NI_INVALID_PORT ${LANG_SPANISHINTERNATIONAL} "El puerto debe ser un número entre 1 y 65535."
LangString NI_DATABASE_TITLE ${LANG_SPANISHINTERNATIONAL} "Base de datos"
LangString NI_DATABASE_SUBTITLE ${LANG_SPANISHINTERNATIONAL} "Elija la base de datos utilizada por nginx ignition."
LangString NI_DB_SQLITE ${LANG_SPANISHINTERNATIONAL} "SQLite integrado (recomendado para pruebas)"
LangString NI_DB_POSTGRES ${LANG_SPANISHINTERNATIONAL} "PostgreSQL (recomendado para producción)"
LangString NI_DB_HOST ${LANG_SPANISHINTERNATIONAL} "Host:"
LangString NI_DB_PORT ${LANG_SPANISHINTERNATIONAL} "Puerto:"
LangString NI_DB_NAME ${LANG_SPANISHINTERNATIONAL} "Nombre de la base de datos:"
LangString NI_DB_SCHEMA ${LANG_SPANISHINTERNATIONAL} "Esquema:"
LangString NI_DB_USER ${LANG_SPANISHINTERNATIONAL} "Usuario:"
LangString NI_DB_PASSWORD ${LANG_SPANISHINTERNATIONAL} "Contraseña:"
LangString NI_DB_SSLMODE ${LANG_SPANISHINTERNATIONAL} "Modo SSL:"
LangString NI_DB_SSL_DISABLE ${LANG_SPANISHINTERNATIONAL} "Deshabilitar"
LangString NI_DB_SSL_REQUIRE ${LANG_SPANISHINTERNATIONAL} "Requerir"
LangString NI_DB_REQUIRED ${LANG_SPANISHINTERNATIONAL} "El host, el nombre de la base de datos, el usuario y la contraseña son obligatorios para PostgreSQL."
LangString NI_DB_CHANGE_WARNING ${LANG_SPANISHINTERNATIONAL} "Está cambiando el controlador de base de datos de una instalación existente. Los datos no se migran automáticamente.$\r$\n$\r$\n¿Continuar?"
LangString NI_SERVICE_TITLE ${LANG_SPANISHINTERNATIONAL} "Servicio de Windows"
LangString NI_SERVICE_SUBTITLE ${LANG_SPANISHINTERNATIONAL} "Elija la cuenta y el modo de inicio utilizados por el servicio de nginx ignition."
LangString NI_SERVICE_ACCOUNT ${LANG_SPANISHINTERNATIONAL} "Cuenta del servicio"
LangString NI_SERVICE_LOCALSYSTEM ${LANG_SPANISHINTERNATIONAL} "LocalSystem (recomendado)"
LangString NI_SERVICE_NETWORKSERVICE ${LANG_SPANISHINTERNATIONAL} "Servicio de red"
LangString NI_SERVICE_LOCALSERVICE ${LANG_SPANISHINTERNATIONAL} "Servicio local"
LangString NI_SERVICE_CUSTOM ${LANG_SPANISHINTERNATIONAL} "Cuenta personalizada"
LangString NI_SERVICE_USER ${LANG_SPANISHINTERNATIONAL} "Nombre de la cuenta:"
LangString NI_SERVICE_PASSWORD ${LANG_SPANISHINTERNATIONAL} "Contraseña:"
LangString NI_SERVICE_PASSWORD_CONFIRM ${LANG_SPANISHINTERNATIONAL} "Confirmar contraseña:"
LangString NI_SERVICE_STARTTYPE ${LANG_SPANISHINTERNATIONAL} "Tipo de inicio"
LangString NI_SERVICE_AUTO ${LANG_SPANISHINTERNATIONAL} "Automático"
LangString NI_SERVICE_MANUAL ${LANG_SPANISHINTERNATIONAL} "Manual"
LangString NI_SERVICE_START_NOW ${LANG_SPANISHINTERNATIONAL} "Iniciar el servicio después de la instalación"
LangString NI_SERVICE_CUSTOM_REQUIRED ${LANG_SPANISHINTERNATIONAL} "Introduzca el nombre de la cuenta y la contraseña de la cuenta personalizada del servicio."
LangString NI_SERVICE_CUSTOM_SUBTITLE ${LANG_SPANISHINTERNATIONAL} "Introduzca las credenciales de la cuenta que ejecutará el servicio de nginx ignition."
LangString NI_SERVICE_CUSTOM_HINT ${LANG_SPANISHINTERNATIONAL} "El instalador concede a esta cuenta el derecho «Iniciar sesión como servicio» cuando es posible. Si el servicio no se inicia, consulte el Registro de eventos de Windows."
LangString NI_SERVICE_PASSWORD_MISMATCH ${LANG_SPANISHINTERNATIONAL} "Las contraseñas no coinciden."
LangString NI_SERVICE_CREATE_FAILED ${LANG_SPANISHINTERNATIONAL} "No se pudo crear el servicio de nginx ignition. Compruebe el nombre de la cuenta y la contraseña y vuelva a ejecutar el instalador.$\r$\n$\r$\nDetalles:"
LangString NI_SERVICE_START_FAILED ${LANG_SPANISHINTERNATIONAL} "El servicio se instaló pero no se pudo iniciar. Consulte el Registro de eventos de Windows para obtener más detalles."
LangString NI_SERVICE_DESCRIPTION ${LANG_SPANISHINTERNATIONAL} "Sirve la interfaz web de nginx ignition y administra nginx."
LangString NI_FIREWALL_TITLE ${LANG_SPANISHINTERNATIONAL} "Firewall y accesos directos"
LangString NI_FIREWALL_SUBTITLE ${LANG_SPANISHINTERNATIONAL} "Elija qué reglas del Firewall de Windows y accesos directos se deben crear."
LangString NI_FIREWALL_UI ${LANG_SPANISHINTERNATIONAL} "Permitir el puerto de la interfaz web (redes de dominio y privadas)"
LangString NI_FIREWALL_HTTP ${LANG_SPANISHINTERNATIONAL} "Permitir el puerto HTTP 80"
LangString NI_FIREWALL_HTTPS ${LANG_SPANISHINTERNATIONAL} "Permitir el puerto HTTPS 443"
LangString NI_DESKTOP_SHORTCUT ${LANG_SPANISHINTERNATIONAL} "Crear un acceso directo en el escritorio a la interfaz web"
LangString NI_STARTMENU_SHORTCUT ${LANG_SPANISHINTERNATIONAL} "Crear un acceso directo en el menú Inicio a la interfaz web"
LangString NI_SECTION_APP ${LANG_SPANISHINTERNATIONAL} "nginx ignition"
LangString NI_SHORTCUT_NAME ${LANG_SPANISHINTERNATIONAL} "nginx ignition"
LangString NI_UNINSTALL_SHORTCUT ${LANG_SPANISHINTERNATIONAL} "Desinstalar nginx ignition"
LangString NI_UNINSTALL_OPTIONS_TITLE ${LANG_SPANISHINTERNATIONAL} "Opciones de desinstalación"
LangString NI_UNINSTALL_OPTIONS_SUBTITLE ${LANG_SPANISHINTERNATIONAL} "Elija qué desea eliminar de este equipo."
LangString NI_UNINSTALL_PURGE_CHECKBOX ${LANG_SPANISHINTERNATIONAL} "Eliminar la configuración y los datos de C:\ProgramData\nginx-ignition"
LangString NI_UNINSTALL_PURGE_HINT ${LANG_SPANISHINTERNATIONAL} "Deje esta casilla desmarcada para conservar la configuración y la base de datos para una instalación futura."
LangString NI_UNINSTALL_KEEP_DATA ${LANG_SPANISHINTERNATIONAL} "Conservando la configuración y los datos en C:\ProgramData\nginx-ignition."
LangString NI_UPGRADE_TEXT ${LANG_SPANISHINTERNATIONAL} "Se detectó una instalación existente de nginx ignition. El servicio se detendrá durante la actualización. La configuración y los datos se conservarán."
LangString NI_ERR_ARCH_X64 ${LANG_SPANISHINTERNATIONAL} "Este instalador requiere una versión de 64 bits de Windows."
LangString NI_ERR_ARCH_ARM64 ${LANG_SPANISHINTERNATIONAL} "Este instalador requiere Windows en ARM64."
LangString NI_ERR_ARCH_MISMATCH ${LANG_SPANISHINTERNATIONAL} "Este instalador no es compatible con esta arquitectura de procesador. Descargue el instalador correspondiente a su arquitectura desde la página de versiones."
LangString NI_ERR_WINVER ${LANG_SPANISHINTERNATIONAL} "nginx ignition requiere Windows 10 o Windows Server 2016 o posterior."
LangString NI_ERR_CONFIG ${LANG_SPANISHINTERNATIONAL} "No se pudo escribir el archivo de configuración. Compruebe los permisos de C:\ProgramData\nginx-ignition e inténtelo de nuevo."
LangString NI_ERR_SERVICE_DELETE ${LANG_SPANISHINTERNATIONAL} "No se pudo detener ni eliminar el servicio existente de nginx ignition. Deténgalo manualmente y vuelva a ejecutar el instalador."
LangString NI_ERR_DIR ${LANG_SPANISHINTERNATIONAL} "No se pudo crear el directorio de instalación."
LangString NI_ERR_FIREWALL ${LANG_SPANISHINTERNATIONAL} "No se pudieron crear algunas reglas del Firewall de Windows. Puede añadirlas manualmente más tarde."
LangString NI_CONFIG_IMPORT_FAILED ${LANG_SPANISHINTERNATIONAL} "No se pudo copiar el archivo de configuración especificado con /CONFIG. Compruebe que el archivo existe e inténtelo de nuevo."
LangString NI_DETAIL_STOP ${LANG_SPANISHINTERNATIONAL} "Deteniendo el servicio existente..."
LangString NI_DETAIL_CONFIG ${LANG_SPANISHINTERNATIONAL} "Escribiendo el archivo de configuración..."
LangString NI_DETAIL_ACL ${LANG_SPANISHINTERNATIONAL} "Estableciendo permisos de archivo..."
LangString NI_DETAIL_EVENTLOG ${LANG_SPANISHINTERNATIONAL} "Registrando el origen del Registro de eventos..."
LangString NI_DETAIL_SERVICE ${LANG_SPANISHINTERNATIONAL} "Configurando el servicio de Windows..."
LangString NI_DETAIL_FIREWALL ${LANG_SPANISHINTERNATIONAL} "Configurando el Firewall de Windows..."
LangString NI_DETAIL_SHORTCUTS ${LANG_SPANISHINTERNATIONAL} "Creando accesos directos..."
LangString NI_DETAIL_START ${LANG_SPANISHINTERNATIONAL} "Iniciando el servicio de nginx ignition..."
LangString NI_DETAIL_UNINSTALL ${LANG_SPANISHINTERNATIONAL} "Eliminando nginx ignition..."
