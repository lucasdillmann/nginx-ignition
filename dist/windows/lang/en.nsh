; English strings for the nginx ignition installer.

LangString NI_NAME ${LANG_ENGLISH} "nginx ignition"

; Group box labels
LangString NI_GROUP_WEB ${LANG_ENGLISH} "Web interface"
LangString NI_GROUP_DATA ${LANG_ENGLISH} "Data"
LangString NI_GROUP_NGINX ${LANG_ENGLISH} "nginx"
LangString NI_GROUP_VPN ${LANG_ENGLISH} "VPN"
LangString NI_GROUP_POSTGRES ${LANG_ENGLISH} "PostgreSQL connection"
LangString NI_GROUP_FIREWALL ${LANG_ENGLISH} "Windows Firewall"
LangString NI_GROUP_SHORTCUTS ${LANG_ENGLISH} "Shortcuts"
LangString NI_WELCOME_TITLE ${LANG_ENGLISH} "Welcome to the nginx ignition setup"
LangString NI_WELCOME_TEXT ${LANG_ENGLISH} "This wizard will install nginx ignition and register it as a Windows service.$\r$\n$\r$\nnginx ignition is a modern web interface for managing the nginx web server. nginx is not included and must be installed separately.$\r$\n$\r$\nClick Next to continue."
LangString NI_VERSION_LABEL ${LANG_ENGLISH} "Version"
LangString NI_FINISH_TITLE ${LANG_ENGLISH} "Installation complete"
LangString NI_FINISH_TEXT ${LANG_ENGLISH} "nginx ignition has been installed successfully. Open the web interface to create your first user and finish the setup."
LangString NI_FINISH_RUN ${LANG_ENGLISH} "Open nginx ignition"
LangString NI_FINISH_LINK ${LANG_ENGLISH} "Project website"
LangString NI_INSTALLTYPE_TITLE ${LANG_ENGLISH} "Installation type"
LangString NI_INSTALLTYPE_SUBTITLE ${LANG_ENGLISH} "Choose how you want to configure nginx ignition."
LangString NI_INSTALLTYPE_EXPRESS ${LANG_ENGLISH} "Express (recommended)"
LangString NI_INSTALLTYPE_EXPRESS_DESC ${LANG_ENGLISH} "Uses the detected nginx installation, listens on 127.0.0.1:8090, and uses the embedded SQLite database (recommended for tests) with the LocalSystem account."
LangString NI_INSTALLTYPE_ADVANCED ${LANG_ENGLISH} "Advanced"
LangString NI_INSTALLTYPE_ADVANCED_DESC ${LANG_ENGLISH} "Lets you configure nginx, server ports, the database, the service account and firewall rules."
LangString NI_NGINX_TITLE ${LANG_ENGLISH} "nginx configuration"
LangString NI_NGINX_SUBTITLE ${LANG_ENGLISH} "Tell nginx ignition where nginx is installed and where to write its configuration."
LangString NI_NGINX_PATH ${LANG_ENGLISH} "nginx.exe path:"
LangString NI_BROWSE ${LANG_ENGLISH} "Browse..."
LangString NI_FILE_FILTER ${LANG_ENGLISH} "Executables (*.exe)|*.exe|All files (*.*)|*.*"
LangString NI_NGINX_CONFIG_DIR ${LANG_ENGLISH} "Managed nginx configuration directory:"
LangString NI_VPN_CONFIG_DIR ${LANG_ENGLISH} "VPN configuration directory:"
LangString NI_NGINX_HINT ${LANG_ENGLISH} "The nginx.exe path must be absolute so the Windows service can find it."
LangString NI_NGINX_NOT_FOUND ${LANG_ENGLISH} "nginx.exe was not found at the selected path. nginx ignition can still be installed, but you must set a valid path in the configuration file before starting the service.$\r$\n$\r$\nContinue anyway?"
LangString NI_SERVER_TITLE ${LANG_ENGLISH} "Server and data"
LangString NI_SERVER_SUBTITLE ${LANG_ENGLISH} "Configure the address and port used by the web interface and where data is stored."
LangString NI_SERVER_ADDRESS ${LANG_ENGLISH} "Listen address:"
LangString NI_SERVER_PORT ${LANG_ENGLISH} "HTTP port:"
LangString NI_SERVER_HINT ${LANG_ENGLISH} "Use 127.0.0.1 to accept only local connections, or 0.0.0.0 to expose the web interface on the network."
LangString NI_DATA_DIR ${LANG_ENGLISH} "Data directory:"
LangString NI_INVALID_PORT ${LANG_ENGLISH} "The port must be a number between 1 and 65535."
LangString NI_DATABASE_TITLE ${LANG_ENGLISH} "Database"
LangString NI_DATABASE_SUBTITLE ${LANG_ENGLISH} "Choose the database used by nginx ignition."
LangString NI_DB_SQLITE ${LANG_ENGLISH} "Embedded SQLite (recommended for tests)"
LangString NI_DB_POSTGRES ${LANG_ENGLISH} "PostgreSQL (recommended for production)"
LangString NI_DB_HOST ${LANG_ENGLISH} "Host:"
LangString NI_DB_PORT ${LANG_ENGLISH} "Port:"
LangString NI_DB_NAME ${LANG_ENGLISH} "Database name:"
LangString NI_DB_SCHEMA ${LANG_ENGLISH} "Schema:"
LangString NI_DB_USER ${LANG_ENGLISH} "Username:"
LangString NI_DB_PASSWORD ${LANG_ENGLISH} "Password:"
LangString NI_DB_SSLMODE ${LANG_ENGLISH} "SSL mode:"
LangString NI_DB_SSL_DISABLE ${LANG_ENGLISH} "Disable"
LangString NI_DB_SSL_REQUIRE ${LANG_ENGLISH} "Require"
LangString NI_DB_REQUIRED ${LANG_ENGLISH} "Host, database name, username and password are required for PostgreSQL."
LangString NI_DB_CHANGE_WARNING ${LANG_ENGLISH} "You are changing the database driver of an existing installation. Data is not migrated automatically.$\r$\n$\r$\nContinue?"
LangString NI_SERVICE_TITLE ${LANG_ENGLISH} "Windows service"
LangString NI_SERVICE_SUBTITLE ${LANG_ENGLISH} "Choose the account and startup mode used by the nginx ignition service."
LangString NI_SERVICE_ACCOUNT ${LANG_ENGLISH} "Service account"
LangString NI_SERVICE_LOCALSYSTEM ${LANG_ENGLISH} "LocalSystem (recommended)"
LangString NI_SERVICE_NETWORKSERVICE ${LANG_ENGLISH} "Network Service"
LangString NI_SERVICE_LOCALSERVICE ${LANG_ENGLISH} "Local Service"
LangString NI_SERVICE_CUSTOM ${LANG_ENGLISH} "Custom account"
LangString NI_SERVICE_USER ${LANG_ENGLISH} "Account name:"
LangString NI_SERVICE_PASSWORD ${LANG_ENGLISH} "Password:"
LangString NI_SERVICE_PASSWORD_CONFIRM ${LANG_ENGLISH} "Confirm password:"
LangString NI_SERVICE_STARTTYPE ${LANG_ENGLISH} "Startup type"
LangString NI_SERVICE_AUTO ${LANG_ENGLISH} "Automatic"
LangString NI_SERVICE_MANUAL ${LANG_ENGLISH} "Manual"
LangString NI_SERVICE_START_NOW ${LANG_ENGLISH} "Start the service after installation"
LangString NI_SERVICE_CUSTOM_REQUIRED ${LANG_ENGLISH} "Enter the account name and password for the custom service account."
LangString NI_SERVICE_CUSTOM_SUBTITLE ${LANG_ENGLISH} "Enter the credentials for the account that will run the nginx ignition service."
LangString NI_SERVICE_CUSTOM_HINT ${LANG_ENGLISH} "The installer grants this account the Log on as a service right when possible. If the service does not start, check the Windows Event Log."
LangString NI_SERVICE_PASSWORD_MISMATCH ${LANG_ENGLISH} "The passwords do not match."
LangString NI_SERVICE_CREATE_FAILED ${LANG_ENGLISH} "The nginx ignition service could not be created. Check the account name and password, then run the installer again.$\r$\n$\r$\nDetails:"
LangString NI_SERVICE_START_FAILED ${LANG_ENGLISH} "The service was installed but could not be started. Check the Windows Event Log for details."
LangString NI_SERVICE_DESCRIPTION ${LANG_ENGLISH} "Serves the nginx ignition web interface and manages nginx."
LangString NI_FIREWALL_TITLE ${LANG_ENGLISH} "Firewall and shortcuts"
LangString NI_FIREWALL_SUBTITLE ${LANG_ENGLISH} "Choose which Windows Firewall rules and shortcuts should be created."
LangString NI_FIREWALL_UI ${LANG_ENGLISH} "Allow the web interface port (domain and private networks)"
LangString NI_FIREWALL_HTTP ${LANG_ENGLISH} "Allow HTTP port 80"
LangString NI_FIREWALL_HTTPS ${LANG_ENGLISH} "Allow HTTPS port 443"
LangString NI_DESKTOP_SHORTCUT ${LANG_ENGLISH} "Create a desktop shortcut to the web interface"
LangString NI_STARTMENU_SHORTCUT ${LANG_ENGLISH} "Create a Start Menu shortcut to the web interface"
LangString NI_SECTION_APP ${LANG_ENGLISH} "nginx ignition"
LangString NI_SHORTCUT_NAME ${LANG_ENGLISH} "nginx ignition"
LangString NI_UNINSTALL_SHORTCUT ${LANG_ENGLISH} "Uninstall nginx ignition"
LangString NI_UNINSTALL_OPTIONS_TITLE ${LANG_ENGLISH} "Uninstall options"
LangString NI_UNINSTALL_OPTIONS_SUBTITLE ${LANG_ENGLISH} "Choose what to remove from this computer."
LangString NI_UNINSTALL_PURGE_CHECKBOX ${LANG_ENGLISH} "Delete configuration and data in C:\ProgramData\nginx-ignition"
LangString NI_UNINSTALL_PURGE_HINT ${LANG_ENGLISH} "Leave this unchecked to keep your configuration and database for a future installation."
LangString NI_UNINSTALL_KEEP_DATA ${LANG_ENGLISH} "Keeping configuration and data in C:\ProgramData\nginx-ignition."
LangString NI_UPGRADE_TEXT ${LANG_ENGLISH} "An existing nginx ignition installation was detected. The service will be stopped during the upgrade. Configuration and data will be preserved."
LangString NI_ERR_ARCH_X64 ${LANG_ENGLISH} "This installer requires a 64-bit version of Windows."
LangString NI_ERR_ARCH_ARM64 ${LANG_ENGLISH} "This installer requires Windows on ARM64."
LangString NI_ERR_ARCH_MISMATCH ${LANG_ENGLISH} "This installer does not support this processor architecture. Download the installer that matches your architecture from the releases page."
LangString NI_ERR_WINVER ${LANG_ENGLISH} "nginx ignition requires Windows 10 or Windows Server 2016 or later."
LangString NI_ERR_CONFIG ${LANG_ENGLISH} "The configuration file could not be written. Check the permissions of C:\ProgramData\nginx-ignition and try again."
LangString NI_ERR_SERVICE_DELETE ${LANG_ENGLISH} "The existing nginx ignition service could not be stopped or removed. Stop it manually and run the installer again."
LangString NI_ERR_DIR ${LANG_ENGLISH} "The installation directory could not be created."
LangString NI_ERR_FIREWALL ${LANG_ENGLISH} "Some Windows Firewall rules could not be created. You can add them manually later."
LangString NI_CONFIG_IMPORT_FAILED ${LANG_ENGLISH} "The configuration file specified with /CONFIG could not be copied. Check that the file exists and try again."
