; German strings for the nginx ignition installer.

LangString NI_NAME ${LANG_GERMAN} "nginx ignition"

; Group box labels
LangString NI_GROUP_WEB ${LANG_GERMAN} "Weboberfläche"
LangString NI_GROUP_DATA ${LANG_GERMAN} "Daten"
LangString NI_GROUP_NGINX ${LANG_GERMAN} "nginx"
LangString NI_GROUP_VPN ${LANG_GERMAN} "VPN"
LangString NI_GROUP_POSTGRES ${LANG_GERMAN} "PostgreSQL-Verbindung"
LangString NI_GROUP_FIREWALL ${LANG_GERMAN} "Windows-Firewall"
LangString NI_GROUP_SHORTCUTS ${LANG_GERMAN} "Verknüpfungen"
LangString NI_WELCOME_TITLE ${LANG_GERMAN} "Willkommen beim Setup von nginx ignition"
LangString NI_WELCOME_TEXT ${LANG_GERMAN} "Dieser Assistent installiert nginx ignition und registriert es als Windows-Dienst.$\r$\n$\r$\nnginx ignition ist eine moderne Weboberfläche zur Verwaltung des nginx-Webservers. nginx ist nicht enthalten und muss separat installiert werden.$\r$\n$\r$\nKlicken Sie auf Weiter, um fortzufahren."
LangString NI_VERSION_LABEL ${LANG_GERMAN} "Version"
LangString NI_FINISH_TITLE ${LANG_GERMAN} "Installation abgeschlossen"
LangString NI_FINISH_TEXT ${LANG_GERMAN} "nginx ignition wurde erfolgreich installiert. Öffnen Sie die Weboberfläche, um Ihren ersten Benutzer zu erstellen und die Einrichtung abzuschließen."
LangString NI_FINISH_RUN ${LANG_GERMAN} "nginx ignition öffnen"
LangString NI_FINISH_LINK ${LANG_GERMAN} "Projektwebsite"
LangString NI_INSTALLTYPE_TITLE ${LANG_GERMAN} "Installationsart"
LangString NI_INSTALLTYPE_SUBTITLE ${LANG_GERMAN} "Wählen Sie, wie nginx ignition konfiguriert werden soll."
LangString NI_INSTALLTYPE_EXPRESS ${LANG_GERMAN} "Express (empfohlen)"
LangString NI_INSTALLTYPE_EXPRESS_DESC ${LANG_GERMAN} "Verwendet die erkannte nginx-Installation, lauscht auf 127.0.0.1:8090 und nutzt die integrierte SQLite-Datenbank (empfohlen für Tests) mit dem LocalSystem-Konto."
LangString NI_INSTALLTYPE_ADVANCED ${LANG_GERMAN} "Erweitert"
LangString NI_INSTALLTYPE_ADVANCED_DESC ${LANG_GERMAN} "Ermöglicht die Konfiguration von nginx, Server-Ports, Datenbank, Dienstkonto und Firewallregeln."
LangString NI_NGINX_TITLE ${LANG_GERMAN} "nginx-Konfiguration"
LangString NI_NGINX_SUBTITLE ${LANG_GERMAN} "Geben Sie an, wo nginx installiert ist und wohin nginx ignition seine Konfiguration schreiben soll."
LangString NI_NGINX_PATH ${LANG_GERMAN} "Pfad zu nginx.exe:"
LangString NI_BROWSE ${LANG_GERMAN} "Durchsuchen..."
LangString NI_FILE_FILTER ${LANG_GERMAN} "Programme (*.exe)|*.exe|Alle Dateien (*.*)|*.*"
LangString NI_NGINX_CONFIG_DIR ${LANG_GERMAN} "Verzeichnis für verwaltete nginx-Konfiguration:"
LangString NI_VPN_CONFIG_DIR ${LANG_GERMAN} "VPN-Konfigurationsverzeichnis:"
LangString NI_NGINX_HINT ${LANG_GERMAN} "Der Pfad zu nginx.exe muss absolut sein, damit der Windows-Dienst ihn finden kann."
LangString NI_NGINX_NOT_FOUND ${LANG_GERMAN} "nginx.exe wurde am ausgewählten Pfad nicht gefunden. nginx ignition kann trotzdem installiert werden, aber Sie müssen vor dem Start des Dienstes einen gültigen Pfad in der Konfigurationsdatei festlegen.$\r$\n$\r$\nTrotzdem fortfahren?"
LangString NI_SERVER_TITLE ${LANG_GERMAN} "Server und Daten"
LangString NI_SERVER_SUBTITLE ${LANG_GERMAN} "Konfigurieren Sie Adresse und Port der Weboberfläche sowie den Speicherort der Daten."
LangString NI_SERVER_ADDRESS ${LANG_GERMAN} "Listen-Adresse:"
LangString NI_SERVER_PORT ${LANG_GERMAN} "HTTP-Port:"
LangString NI_SERVER_HINT ${LANG_GERMAN} "Verwenden Sie 127.0.0.1, um nur lokale Verbindungen zuzulassen, oder 0.0.0.0, um die Weboberfläche im Netzwerk bereitzustellen."
LangString NI_DATA_DIR ${LANG_GERMAN} "Datenverzeichnis:"
LangString NI_INVALID_PORT ${LANG_GERMAN} "Der Port muss eine Zahl zwischen 1 und 65535 sein."
LangString NI_DATABASE_TITLE ${LANG_GERMAN} "Datenbank"
LangString NI_DATABASE_SUBTITLE ${LANG_GERMAN} "Wählen Sie die von nginx ignition verwendete Datenbank."
LangString NI_DB_SQLITE ${LANG_GERMAN} "Integriertes SQLite (empfohlen für Tests)"
LangString NI_DB_POSTGRES ${LANG_GERMAN} "PostgreSQL (empfohlen für Produktion)"
LangString NI_DB_HOST ${LANG_GERMAN} "Host:"
LangString NI_DB_PORT ${LANG_GERMAN} "Port:"
LangString NI_DB_NAME ${LANG_GERMAN} "Datenbankname:"
LangString NI_DB_SCHEMA ${LANG_GERMAN} "Schema:"
LangString NI_DB_USER ${LANG_GERMAN} "Benutzername:"
LangString NI_DB_PASSWORD ${LANG_GERMAN} "Passwort:"
LangString NI_DB_SSLMODE ${LANG_GERMAN} "SSL-Modus:"
LangString NI_DB_SSL_DISABLE ${LANG_GERMAN} "Deaktivieren"
LangString NI_DB_SSL_REQUIRE ${LANG_GERMAN} "Erfordern"
LangString NI_DB_REQUIRED ${LANG_GERMAN} "Host, Datenbankname, Benutzername und Passwort sind für PostgreSQL erforderlich."
LangString NI_DB_CHANGE_WARNING ${LANG_GERMAN} "Sie ändern den Datenbanktreiber einer vorhandenen Installation. Daten werden nicht automatisch migriert.$\r$\n$\r$\nFortfahren?"
LangString NI_SERVICE_TITLE ${LANG_GERMAN} "Windows-Dienst"
LangString NI_SERVICE_SUBTITLE ${LANG_GERMAN} "Wählen Sie das Konto und den Starttyp des nginx ignition-Dienstes."
LangString NI_SERVICE_ACCOUNT ${LANG_GERMAN} "Dienstkonto"
LangString NI_SERVICE_LOCALSYSTEM ${LANG_GERMAN} "LocalSystem (empfohlen)"
LangString NI_SERVICE_NETWORKSERVICE ${LANG_GERMAN} "Netzwerkdienst"
LangString NI_SERVICE_LOCALSERVICE ${LANG_GERMAN} "Lokaler Dienst"
LangString NI_SERVICE_CUSTOM ${LANG_GERMAN} "Benutzerdefiniertes Konto"
LangString NI_SERVICE_USER ${LANG_GERMAN} "Kontoname:"
LangString NI_SERVICE_PASSWORD ${LANG_GERMAN} "Passwort:"
LangString NI_SERVICE_PASSWORD_CONFIRM ${LANG_GERMAN} "Passwort bestätigen:"
LangString NI_SERVICE_STARTTYPE ${LANG_GERMAN} "Starttyp"
LangString NI_SERVICE_AUTO ${LANG_GERMAN} "Automatisch"
LangString NI_SERVICE_MANUAL ${LANG_GERMAN} "Manuell"
LangString NI_SERVICE_START_NOW ${LANG_GERMAN} "Dienst nach der Installation starten"
LangString NI_SERVICE_CUSTOM_REQUIRED ${LANG_GERMAN} "Geben Sie Kontoname und Passwort für das benutzerdefinierte Dienstkonto ein."
LangString NI_SERVICE_CUSTOM_SUBTITLE ${LANG_GERMAN} "Geben Sie die Anmeldedaten für das Konto ein, unter dem der nginx ignition-Dienst ausgeführt wird."
LangString NI_SERVICE_CUSTOM_HINT ${LANG_GERMAN} "Das Setup erteilt diesem Konto nach Möglichkeit das Recht „Als Dienst anmelden“. Wenn der Dienst nicht startet, prüfen Sie das Windows-Ereignisprotokoll."
LangString NI_SERVICE_PASSWORD_MISMATCH ${LANG_GERMAN} "Die Passwörter stimmen nicht überein."
LangString NI_SERVICE_CREATE_FAILED ${LANG_GERMAN} "Der nginx ignition-Dienst konnte nicht erstellt werden. Überprüfen Sie Kontoname und Passwort und führen Sie das Setup erneut aus.$\r$\n$\r$\nDetails:"
LangString NI_SERVICE_START_FAILED ${LANG_GERMAN} "Der Dienst wurde installiert, konnte aber nicht gestartet werden. Weitere Informationen finden Sie im Windows-Ereignisprotokoll."
LangString NI_SERVICE_DESCRIPTION ${LANG_GERMAN} "Stellt die nginx ignition-Weboberfläche bereit und verwaltet nginx."
LangString NI_FIREWALL_TITLE ${LANG_GERMAN} "Firewall und Verknüpfungen"
LangString NI_FIREWALL_SUBTITLE ${LANG_GERMAN} "Wählen Sie, welche Windows-Firewallregeln und Verknüpfungen erstellt werden sollen."
LangString NI_FIREWALL_UI ${LANG_GERMAN} "Port der Weboberfläche zulassen (Domänen- und private Netzwerke)"
LangString NI_FIREWALL_HTTP ${LANG_GERMAN} "HTTP-Port 80 zulassen"
LangString NI_FIREWALL_HTTPS ${LANG_GERMAN} "HTTPS-Port 443 zulassen"
LangString NI_DESKTOP_SHORTCUT ${LANG_GERMAN} "Desktopverknüpfung zur Weboberfläche erstellen"
LangString NI_STARTMENU_SHORTCUT ${LANG_GERMAN} "Startmenüverknüpfung zur Weboberfläche erstellen"
LangString NI_SECTION_APP ${LANG_GERMAN} "nginx ignition"
LangString NI_SHORTCUT_NAME ${LANG_GERMAN} "nginx ignition"
LangString NI_UNINSTALL_SHORTCUT ${LANG_GERMAN} "nginx ignition deinstallieren"
LangString NI_UNINSTALL_OPTIONS_TITLE ${LANG_GERMAN} "Deinstallationsoptionen"
LangString NI_UNINSTALL_OPTIONS_SUBTITLE ${LANG_GERMAN} "Wählen Sie, was von diesem Computer entfernt werden soll."
LangString NI_UNINSTALL_PURGE_CHECKBOX ${LANG_GERMAN} "Konfiguration und Daten in C:\ProgramData\nginx-ignition löschen"
LangString NI_UNINSTALL_PURGE_HINT ${LANG_GERMAN} "Lassen Sie dieses Kontrollkästchen deaktiviert, um Konfiguration und Datenbank für eine spätere Installation zu behalten."
LangString NI_UNINSTALL_KEEP_DATA ${LANG_GERMAN} "Konfiguration und Daten in C:\ProgramData\nginx-ignition bleiben erhalten."
LangString NI_UPGRADE_TEXT ${LANG_GERMAN} "Eine vorhandene nginx ignition-Installation wurde erkannt. Der Dienst wird während des Upgrades gestoppt. Konfiguration und Daten bleiben erhalten."
LangString NI_ERR_ARCH_X64 ${LANG_GERMAN} "Dieses Setup erfordert eine 64-Bit-Version von Windows."
LangString NI_ERR_ARCH_ARM64 ${LANG_GERMAN} "Dieses Setup erfordert Windows auf ARM64."
LangString NI_ERR_ARCH_MISMATCH ${LANG_GERMAN} "Dieses Setup unterstützt diese Prozessorarchitektur nicht. Laden Sie das Setup für Ihre Architektur von der Releases-Seite herunter."
LangString NI_ERR_WINVER ${LANG_GERMAN} "nginx ignition erfordert Windows 10 oder Windows Server 2016 oder neuer."
LangString NI_ERR_CONFIG ${LANG_GERMAN} "Die Konfigurationsdatei konnte nicht geschrieben werden. Überprüfen Sie die Berechtigungen von C:\ProgramData\nginx-ignition und versuchen Sie es erneut."
LangString NI_ERR_SERVICE_DELETE ${LANG_GERMAN} "Der vorhandene nginx ignition-Dienst konnte nicht gestoppt oder entfernt werden. Stoppen Sie ihn manuell und führen Sie das Setup erneut aus."
LangString NI_ERR_DIR ${LANG_GERMAN} "Das Installationsverzeichnis konnte nicht erstellt werden."
LangString NI_ERR_FIREWALL ${LANG_GERMAN} "Einige Windows-Firewallregeln konnten nicht erstellt werden. Sie können sie später manuell hinzufügen."
LangString NI_CONFIG_IMPORT_FAILED ${LANG_GERMAN} "Die mit /CONFIG angegebene Konfigurationsdatei konnte nicht kopiert werden. Prüfen Sie, ob die Datei vorhanden ist, und versuchen Sie es erneut."
LangString NI_DETAIL_STOP ${LANG_GERMAN} "Vorhandener Dienst wird gestoppt..."
LangString NI_DETAIL_CONFIG ${LANG_GERMAN} "Konfigurationsdatei wird geschrieben..."
LangString NI_DETAIL_ACL ${LANG_GERMAN} "Dateiberechtigungen werden festgelegt..."
LangString NI_DETAIL_EVENTLOG ${LANG_GERMAN} "Ereignisprotokollquelle wird registriert..."
LangString NI_DETAIL_SERVICE ${LANG_GERMAN} "Windows-Dienst wird konfiguriert..."
LangString NI_DETAIL_FIREWALL ${LANG_GERMAN} "Windows-Firewall wird konfiguriert..."
LangString NI_DETAIL_SHORTCUTS ${LANG_GERMAN} "Verknüpfungen werden erstellt..."
LangString NI_DETAIL_START ${LANG_GERMAN} "nginx ignition-Dienst wird gestartet..."
LangString NI_DETAIL_UNINSTALL ${LANG_GERMAN} "nginx ignition wird entfernt..."
