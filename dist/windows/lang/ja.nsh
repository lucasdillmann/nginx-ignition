; Japanese strings for the nginx ignition installer.

LangString NI_NAME ${LANG_JAPANESE} "nginx ignition"

; Group box labels
LangString NI_GROUP_WEB ${LANG_JAPANESE} "Web インターフェース"
LangString NI_GROUP_DATA ${LANG_JAPANESE} "データ"
LangString NI_GROUP_NGINX ${LANG_JAPANESE} "nginx"
LangString NI_GROUP_VPN ${LANG_JAPANESE} "VPN"
LangString NI_GROUP_POSTGRES ${LANG_JAPANESE} "PostgreSQL 接続"
LangString NI_GROUP_FIREWALL ${LANG_JAPANESE} "Windows ファイアウォール"
LangString NI_GROUP_SHORTCUTS ${LANG_JAPANESE} "ショートカット"
LangString NI_WELCOME_TITLE ${LANG_JAPANESE} "nginx ignition セットアップへようこそ"
LangString NI_WELCOME_TEXT ${LANG_JAPANESE} "このウィザードでは、nginx ignition をインストールし、Windows サービスとして登録します。$\r$\n$\r$\nnginx ignition は、nginx Web サーバーを管理するためのモダンな Web インターフェースです。nginx は含まれていないため、別途インストールする必要があります。$\r$\n$\r$\n続行するには [次へ] をクリックしてください。"
LangString NI_VERSION_LABEL ${LANG_JAPANESE} "バージョン"
LangString NI_FINISH_TITLE ${LANG_JAPANESE} "インストール完了"
LangString NI_FINISH_TEXT ${LANG_JAPANESE} "nginx ignition が正常にインストールされました。Web インターフェースを開いて最初のユーザーを作成し、セットアップを完了してください。"
LangString NI_FINISH_RUN ${LANG_JAPANESE} "nginx ignition を開く"
LangString NI_FINISH_LINK ${LANG_JAPANESE} "プロジェクト Web サイト"
LangString NI_INSTALLTYPE_TITLE ${LANG_JAPANESE} "インストールの種類"
LangString NI_INSTALLTYPE_SUBTITLE ${LANG_JAPANESE} "nginx ignition の構成方法を選択してください。"
LangString NI_INSTALLTYPE_EXPRESS ${LANG_JAPANESE} "簡易 (推奨)"
LangString NI_INSTALLTYPE_EXPRESS_DESC ${LANG_JAPANESE} "検出された nginx インストールを使用し、127.0.0.1:8090 で待ち受け、組み込み SQLite データベース（テストでの使用を推奨）と LocalSystem アカウントを使用します。"
LangString NI_INSTALLTYPE_ADVANCED ${LANG_JAPANESE} "詳細"
LangString NI_INSTALLTYPE_ADVANCED_DESC ${LANG_JAPANESE} "nginx、サーバーポート、データベース、サービス アカウント、ファイアウォール規則を構成できます。"
LangString NI_NGINX_TITLE ${LANG_JAPANESE} "nginx の構成"
LangString NI_NGINX_SUBTITLE ${LANG_JAPANESE} "nginx のインストール場所と、nginx ignition が構成を書き込む場所を指定します。"
LangString NI_NGINX_PATH ${LANG_JAPANESE} "nginx.exe のパス:"
LangString NI_BROWSE ${LANG_JAPANESE} "参照..."
LangString NI_FILE_FILTER ${LANG_JAPANESE} "実行ファイル (*.exe)|*.exe|すべてのファイル (*.*)|*.*"
LangString NI_NGINX_CONFIG_DIR ${LANG_JAPANESE} "管理対象の nginx 構成ディレクトリ:"
LangString NI_VPN_CONFIG_DIR ${LANG_JAPANESE} "VPN 構成ディレクトリ:"
LangString NI_NGINX_HINT ${LANG_JAPANESE} "Windows サービスが検出できるように、nginx.exe のパスは絶対パスである必要があります。"
LangString NI_NGINX_NOT_FOUND ${LANG_JAPANESE} "選択したパスに nginx.exe が見つかりませんでした。nginx ignition は引き続きインストールできますが、サービスを開始する前に構成ファイルで有効なパスを設定する必要があります。$\r$\n$\r$\n続行しますか?"
LangString NI_SERVER_TITLE ${LANG_JAPANESE} "サーバーとデータ"
LangString NI_SERVER_SUBTITLE ${LANG_JAPANESE} "Web インターフェースで使用するアドレスとポート、およびデータの保存場所を構成します。"
LangString NI_SERVER_ADDRESS ${LANG_JAPANESE} "リッスン アドレス:"
LangString NI_SERVER_PORT ${LANG_JAPANESE} "HTTP ポート:"
LangString NI_SERVER_HINT ${LANG_JAPANESE} "127.0.0.1 はローカル接続のみを受け付け、0.0.0.0 は Web インターフェースをネットワークに公開します。"
LangString NI_DATA_DIR ${LANG_JAPANESE} "データ ディレクトリ:"
LangString NI_INVALID_PORT ${LANG_JAPANESE} "ポートは 1 から 65535 までの数値である必要があります。"
LangString NI_DATABASE_TITLE ${LANG_JAPANESE} "データベース"
LangString NI_DATABASE_SUBTITLE ${LANG_JAPANESE} "nginx ignition で使用するデータベースを選択してください。"
LangString NI_DB_SQLITE ${LANG_JAPANESE} "組み込み SQLite (テストでの使用を推奨)"
LangString NI_DB_POSTGRES ${LANG_JAPANESE} "PostgreSQL (本番環境に推奨)"
LangString NI_DB_HOST ${LANG_JAPANESE} "ホスト:"
LangString NI_DB_PORT ${LANG_JAPANESE} "ポート:"
LangString NI_DB_NAME ${LANG_JAPANESE} "データベース名:"
LangString NI_DB_SCHEMA ${LANG_JAPANESE} "スキーマ:"
LangString NI_DB_USER ${LANG_JAPANESE} "ユーザー名:"
LangString NI_DB_PASSWORD ${LANG_JAPANESE} "パスワード:"
LangString NI_DB_SSLMODE ${LANG_JAPANESE} "SSL モード:"
LangString NI_DB_SSL_DISABLE ${LANG_JAPANESE} "無効"
LangString NI_DB_SSL_REQUIRE ${LANG_JAPANESE} "必須"
LangString NI_DB_REQUIRED ${LANG_JAPANESE} "PostgreSQL では、ホスト、データベース名、ユーザー名、パスワードが必須です。"
LangString NI_DB_CHANGE_WARNING ${LANG_JAPANESE} "既存のインストールのデータベース ドライバーを変更しようとしています。データは自動的に移行されません。$\r$\n$\r$\n続行しますか?"
LangString NI_SERVICE_TITLE ${LANG_JAPANESE} "Windows サービス"
LangString NI_SERVICE_SUBTITLE ${LANG_JAPANESE} "nginx ignition サービスで使用するアカウントとスタートアップの種類を選択してください。"
LangString NI_SERVICE_ACCOUNT ${LANG_JAPANESE} "サービス アカウント"
LangString NI_SERVICE_LOCALSYSTEM ${LANG_JAPANESE} "LocalSystem (推奨)"
LangString NI_SERVICE_NETWORKSERVICE ${LANG_JAPANESE} "ネットワーク サービス"
LangString NI_SERVICE_LOCALSERVICE ${LANG_JAPANESE} "ローカル サービス"
LangString NI_SERVICE_CUSTOM ${LANG_JAPANESE} "カスタム アカウント"
LangString NI_SERVICE_USER ${LANG_JAPANESE} "アカウント名:"
LangString NI_SERVICE_PASSWORD ${LANG_JAPANESE} "パスワード:"
LangString NI_SERVICE_PASSWORD_CONFIRM ${LANG_JAPANESE} "パスワードの確認:"
LangString NI_SERVICE_STARTTYPE ${LANG_JAPANESE} "スタートアップの種類"
LangString NI_SERVICE_AUTO ${LANG_JAPANESE} "自動"
LangString NI_SERVICE_MANUAL ${LANG_JAPANESE} "手動"
LangString NI_SERVICE_START_NOW ${LANG_JAPANESE} "インストール後にサービスを開始する"
LangString NI_SERVICE_CUSTOM_REQUIRED ${LANG_JAPANESE} "カスタム サービス アカウントのアカウント名とパスワードを入力してください。"
LangString NI_SERVICE_CUSTOM_SUBTITLE ${LANG_JAPANESE} "nginx ignition サービスを実行するアカウントの資格情報を入力してください。"
LangString NI_SERVICE_CUSTOM_HINT ${LANG_JAPANESE} "インストーラーは可能な場合、このアカウントに「サービスとしてログオン」の権利を付与します。サービスが起動しない場合は、Windows イベント ログを確認してください。"
LangString NI_SERVICE_PASSWORD_MISMATCH ${LANG_JAPANESE} "パスワードが一致しません。"
LangString NI_SERVICE_CREATE_FAILED ${LANG_JAPANESE} "nginx ignition サービスを作成できませんでした。アカウント名とパスワードを確認して、インストーラーを再実行してください。$\r$\n$\r$\n詳細:"
LangString NI_SERVICE_START_FAILED ${LANG_JAPANESE} "サービスはインストールされましたが、開始できませんでした。詳細は Windows イベント ログを確認してください。"
LangString NI_SERVICE_DESCRIPTION ${LANG_JAPANESE} "nginx ignition Web インターフェースを提供し、nginx を管理します。"
LangString NI_FIREWALL_TITLE ${LANG_JAPANESE} "ファイアウォールとショートカット"
LangString NI_FIREWALL_SUBTITLE ${LANG_JAPANESE} "作成する Windows ファイアウォール規則とショートカットを選択してください。"
LangString NI_FIREWALL_UI ${LANG_JAPANESE} "Web インターフェースのポートを許可する (ドメインおよびプライベート ネットワーク)"
LangString NI_FIREWALL_HTTP ${LANG_JAPANESE} "HTTP ポート 80 を許可する"
LangString NI_FIREWALL_HTTPS ${LANG_JAPANESE} "HTTPS ポート 443 を許可する"
LangString NI_DESKTOP_SHORTCUT ${LANG_JAPANESE} "デスクトップに Web インターフェースへのショートカットを作成する"
LangString NI_STARTMENU_SHORTCUT ${LANG_JAPANESE} "スタート メニューに Web インターフェースへのショートカットを作成する"
LangString NI_SECTION_APP ${LANG_JAPANESE} "nginx ignition"
LangString NI_SHORTCUT_NAME ${LANG_JAPANESE} "nginx ignition"
LangString NI_UNINSTALL_SHORTCUT ${LANG_JAPANESE} "nginx ignition をアンインストールする"
LangString NI_UNINSTALL_OPTIONS_TITLE ${LANG_JAPANESE} "アンインストール オプション"
LangString NI_UNINSTALL_OPTIONS_SUBTITLE ${LANG_JAPANESE} "このコンピューターから削除する項目を選択してください。"
LangString NI_UNINSTALL_PURGE_CHECKBOX ${LANG_JAPANESE} "C:\ProgramData\nginx-ignition の構成とデータを削除する"
LangString NI_UNINSTALL_PURGE_HINT ${LANG_JAPANESE} "将来のインストールのために構成とデータベースを保持するには、このチェックボックスをオフのままにしてください。"
LangString NI_UNINSTALL_KEEP_DATA ${LANG_JAPANESE} "C:\ProgramData\nginx-ignition の構成とデータを保持します。"
LangString NI_UPGRADE_TEXT ${LANG_JAPANESE} "既存の nginx ignition インストールが検出されました。アップグレード中にサービスが停止されます。構成とデータは保持されます。"
LangString NI_ERR_ARCH_X64 ${LANG_JAPANESE} "このインストーラーには 64 ビット版の Windows が必要です。"
LangString NI_ERR_ARCH_ARM64 ${LANG_JAPANESE} "このインストーラーには ARM64 上の Windows が必要です。"
LangString NI_ERR_ARCH_MISMATCH ${LANG_JAPANESE} "このインストーラーはこのプロセッサ アーキテクチャに対応していません。リリース ページからお使いのアーキテクチャに合ったインストーラーをダウンロードしてください。"
LangString NI_ERR_WINVER ${LANG_JAPANESE} "nginx ignition には Windows 10 または Windows Server 2016 以降が必要です。"
LangString NI_ERR_CONFIG ${LANG_JAPANESE} "構成ファイルを書き込めませんでした。C:\ProgramData\nginx-ignition のアクセス許可を確認して、再試行してください。"
LangString NI_ERR_SERVICE_DELETE ${LANG_JAPANESE} "既存の nginx ignition サービスを停止または削除できませんでした。手動で停止してから、インストーラーを再実行してください。"
LangString NI_ERR_DIR ${LANG_JAPANESE} "インストール ディレクトリを作成できませんでした。"
LangString NI_ERR_FIREWALL ${LANG_JAPANESE} "一部の Windows ファイアウォール規則を作成できませんでした。後で手動で追加できます。"
LangString NI_CONFIG_IMPORT_FAILED ${LANG_JAPANESE} "/CONFIG で指定された構成ファイルをコピーできませんでした。ファイルが存在することを確認して、再試行してください。"
LangString NI_DETAIL_STOP ${LANG_JAPANESE} "既存のサービスを停止しています..."
LangString NI_DETAIL_CONFIG ${LANG_JAPANESE} "構成ファイルを書き込んでいます..."
LangString NI_DETAIL_ACL ${LANG_JAPANESE} "ファイルのアクセス許可を設定しています..."
LangString NI_DETAIL_EVENTLOG ${LANG_JAPANESE} "イベント ログ ソースを登録しています..."
LangString NI_DETAIL_SERVICE ${LANG_JAPANESE} "Windows サービスを構成しています..."
LangString NI_DETAIL_FIREWALL ${LANG_JAPANESE} "Windows ファイアウォールを構成しています..."
LangString NI_DETAIL_SHORTCUTS ${LANG_JAPANESE} "ショートカットを作成しています..."
LangString NI_DETAIL_START ${LANG_JAPANESE} "nginx ignition サービスを開始しています..."
LangString NI_DETAIL_UNINSTALL ${LANG_JAPANESE} "nginx ignition を削除しています..."
