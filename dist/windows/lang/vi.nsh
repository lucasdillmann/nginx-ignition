; Vietnamese strings for the nginx ignition installer.

LangString NI_NAME ${LANG_VIETNAMESE} "nginx ignition"

; Group box labels
LangString NI_GROUP_WEB ${LANG_VIETNAMESE} "Giao diện web"
LangString NI_GROUP_DATA ${LANG_VIETNAMESE} "Dữ liệu"
LangString NI_GROUP_NGINX ${LANG_VIETNAMESE} "nginx"
LangString NI_GROUP_VPN ${LANG_VIETNAMESE} "VPN"
LangString NI_GROUP_POSTGRES ${LANG_VIETNAMESE} "Kết nối PostgreSQL"
LangString NI_GROUP_FIREWALL ${LANG_VIETNAMESE} "Tường lửa Windows"
LangString NI_GROUP_SHORTCUTS ${LANG_VIETNAMESE} "Lối tắt"
LangString NI_WELCOME_TITLE ${LANG_VIETNAMESE} "Chào mừng bạn đến với trình cài đặt nginx ignition"
LangString NI_WELCOME_TEXT ${LANG_VIETNAMESE} "Trình hướng dẫn này sẽ cài đặt nginx ignition và đăng ký nó như một dịch vụ Windows.$\r$\n$\r$\nnginx ignition là một giao diện web hiện đại để quản lý máy chủ web nginx. nginx không được bao gồm và phải được cài đặt riêng.$\r$\n$\r$\nNhấp vào Tiếp theo để tiếp tục."
LangString NI_VERSION_LABEL ${LANG_VIETNAMESE} "Phiên bản"
LangString NI_FINISH_TITLE ${LANG_VIETNAMESE} "Cài đặt hoàn tất"
LangString NI_FINISH_TEXT ${LANG_VIETNAMESE} "nginx ignition đã được cài đặt thành công. Mở giao diện web để tạo người dùng đầu tiên và hoàn tất quá trình thiết lập."
LangString NI_FINISH_RUN ${LANG_VIETNAMESE} "Mở nginx ignition"
LangString NI_FINISH_LINK ${LANG_VIETNAMESE} "Trang web dự án"
LangString NI_INSTALLTYPE_TITLE ${LANG_VIETNAMESE} "Kiểu cài đặt"
LangString NI_INSTALLTYPE_SUBTITLE ${LANG_VIETNAMESE} "Chọn cách bạn muốn cấu hình nginx ignition."
LangString NI_INSTALLTYPE_EXPRESS ${LANG_VIETNAMESE} "Nhanh (được khuyến nghị)"
LangString NI_INSTALLTYPE_EXPRESS_DESC ${LANG_VIETNAMESE} "Sử dụng bản cài nginx được phát hiện, lắng nghe trên 127.0.0.1:8090 và dùng cơ sở dữ liệu SQLite tích hợp (khuyến nghị cho thử nghiệm) với tài khoản LocalSystem."
LangString NI_INSTALLTYPE_ADVANCED ${LANG_VIETNAMESE} "Nâng cao"
LangString NI_INSTALLTYPE_ADVANCED_DESC ${LANG_VIETNAMESE} "Cho phép cấu hình nginx, cổng máy chủ, cơ sở dữ liệu, tài khoản dịch vụ và quy tắc tường lửa."
LangString NI_NGINX_TITLE ${LANG_VIETNAMESE} "Cấu hình nginx"
LangString NI_NGINX_SUBTITLE ${LANG_VIETNAMESE} "Cho biết nginx được cài đặt ở đâu và nơi nginx ignition sẽ ghi cấu hình của nó."
LangString NI_NGINX_PATH ${LANG_VIETNAMESE} "Đường dẫn nginx.exe:"
LangString NI_BROWSE ${LANG_VIETNAMESE} "Duyệt..."
LangString NI_FILE_FILTER ${LANG_VIETNAMESE} "Tệp thực thi (*.exe)|*.exe|Tất cả tệp (*.*)|*.*"
LangString NI_NGINX_CONFIG_DIR ${LANG_VIETNAMESE} "Thư mục cấu hình nginx được quản lý:"
LangString NI_VPN_CONFIG_DIR ${LANG_VIETNAMESE} "Thư mục cấu hình VPN:"
LangString NI_NGINX_HINT ${LANG_VIETNAMESE} "Đường dẫn nginx.exe phải là đường dẫn tuyệt đối để dịch vụ Windows có thể tìm thấy."
LangString NI_NGINX_NOT_FOUND ${LANG_VIETNAMESE} "Không tìm thấy nginx.exe tại đường dẫn đã chọn. nginx ignition vẫn có thể được cài đặt, nhưng bạn phải đặt đường dẫn hợp lệ trong tệp cấu hình trước khi khởi động dịch vụ.$\r$\n$\r$\nVẫn tiếp tục?"
LangString NI_SERVER_TITLE ${LANG_VIETNAMESE} "Máy chủ và dữ liệu"
LangString NI_SERVER_SUBTITLE ${LANG_VIETNAMESE} "Cấu hình địa chỉ và cổng được giao diện web sử dụng và nơi lưu trữ dữ liệu."
LangString NI_SERVER_ADDRESS ${LANG_VIETNAMESE} "Địa chỉ lắng nghe:"
LangString NI_SERVER_PORT ${LANG_VIETNAMESE} "Cổng HTTP:"
LangString NI_SERVER_HINT ${LANG_VIETNAMESE} "Dùng 127.0.0.1 để chỉ chấp nhận kết nối cục bộ, hoặc 0.0.0.0 để mở giao diện web trong mạng."
LangString NI_DATA_DIR ${LANG_VIETNAMESE} "Thư mục dữ liệu:"
LangString NI_INVALID_PORT ${LANG_VIETNAMESE} "Cổng phải là một số từ 1 đến 65535."
LangString NI_DATABASE_TITLE ${LANG_VIETNAMESE} "Cơ sở dữ liệu"
LangString NI_DATABASE_SUBTITLE ${LANG_VIETNAMESE} "Chọn cơ sở dữ liệu được nginx ignition sử dụng."
LangString NI_DB_SQLITE ${LANG_VIETNAMESE} "SQLite tích hợp (khuyến nghị cho thử nghiệm)"
LangString NI_DB_POSTGRES ${LANG_VIETNAMESE} "PostgreSQL (khuyến nghị cho môi trường sản xuất)"
LangString NI_DB_HOST ${LANG_VIETNAMESE} "Máy chủ:"
LangString NI_DB_PORT ${LANG_VIETNAMESE} "Cổng:"
LangString NI_DB_NAME ${LANG_VIETNAMESE} "Tên cơ sở dữ liệu:"
LangString NI_DB_SCHEMA ${LANG_VIETNAMESE} "Lược đồ:"
LangString NI_DB_USER ${LANG_VIETNAMESE} "Tên người dùng:"
LangString NI_DB_PASSWORD ${LANG_VIETNAMESE} "Mật khẩu:"
LangString NI_DB_SSLMODE ${LANG_VIETNAMESE} "Chế độ SSL:"
LangString NI_DB_SSL_DISABLE ${LANG_VIETNAMESE} "Tắt"
LangString NI_DB_SSL_REQUIRE ${LANG_VIETNAMESE} "Bắt buộc"
LangString NI_DB_REQUIRED ${LANG_VIETNAMESE} "Máy chủ, tên cơ sở dữ liệu, tên người dùng và mật khẩu là bắt buộc đối với PostgreSQL."
LangString NI_DB_CHANGE_WARNING ${LANG_VIETNAMESE} "Bạn đang thay đổi trình điều khiển cơ sở dữ liệu của một cài đặt hiện có. Dữ liệu không được di chuyển tự động.$\r$\n$\r$\nTiếp tục?"
LangString NI_SERVICE_TITLE ${LANG_VIETNAMESE} "Dịch vụ Windows"
LangString NI_SERVICE_SUBTITLE ${LANG_VIETNAMESE} "Chọn tài khoản và kiểu khởi động được dịch vụ nginx ignition sử dụng."
LangString NI_SERVICE_ACCOUNT ${LANG_VIETNAMESE} "Tài khoản dịch vụ"
LangString NI_SERVICE_LOCALSYSTEM ${LANG_VIETNAMESE} "LocalSystem (được khuyến nghị)"
LangString NI_SERVICE_NETWORKSERVICE ${LANG_VIETNAMESE} "Dịch vụ mạng"
LangString NI_SERVICE_LOCALSERVICE ${LANG_VIETNAMESE} "Dịch vụ cục bộ"
LangString NI_SERVICE_CUSTOM ${LANG_VIETNAMESE} "Tài khoản tùy chỉnh"
LangString NI_SERVICE_USER ${LANG_VIETNAMESE} "Tên tài khoản:"
LangString NI_SERVICE_PASSWORD ${LANG_VIETNAMESE} "Mật khẩu:"
LangString NI_SERVICE_PASSWORD_CONFIRM ${LANG_VIETNAMESE} "Xác nhận mật khẩu:"
LangString NI_SERVICE_STARTTYPE ${LANG_VIETNAMESE} "Kiểu khởi động"
LangString NI_SERVICE_AUTO ${LANG_VIETNAMESE} "Tự động"
LangString NI_SERVICE_MANUAL ${LANG_VIETNAMESE} "Thủ công"
LangString NI_SERVICE_START_NOW ${LANG_VIETNAMESE} "Khởi động dịch vụ sau khi cài đặt"
LangString NI_SERVICE_CUSTOM_REQUIRED ${LANG_VIETNAMESE} "Nhập tên tài khoản và mật khẩu cho tài khoản dịch vụ tùy chỉnh."
LangString NI_SERVICE_CUSTOM_SUBTITLE ${LANG_VIETNAMESE} "Nhập thông tin đăng nhập cho tài khoản sẽ chạy dịch vụ nginx ignition."
LangString NI_SERVICE_CUSTOM_HINT ${LANG_VIETNAMESE} "Trình cài đặt cấp cho tài khoản này quyền Đăng nhập như một dịch vụ khi có thể. Nếu dịch vụ không khởi động, hãy kiểm tra Nhật ký sự kiện Windows."
LangString NI_SERVICE_PASSWORD_MISMATCH ${LANG_VIETNAMESE} "Mật khẩu không khớp."
LangString NI_SERVICE_CREATE_FAILED ${LANG_VIETNAMESE} "Không thể tạo dịch vụ nginx ignition. Kiểm tra tên tài khoản và mật khẩu, sau đó chạy lại trình cài đặt.$\r$\n$\r$\nChi tiết:"
LangString NI_SERVICE_START_FAILED ${LANG_VIETNAMESE} "Dịch vụ đã được cài đặt nhưng không thể khởi động. Kiểm tra Nhật ký sự kiện Windows để biết chi tiết."
LangString NI_SERVICE_DESCRIPTION ${LANG_VIETNAMESE} "Cung cấp giao diện web nginx ignition và quản lý nginx."
LangString NI_FIREWALL_TITLE ${LANG_VIETNAMESE} "Tường lửa và lối tắt"
LangString NI_FIREWALL_SUBTITLE ${LANG_VIETNAMESE} "Chọn quy tắc Tường lửa Windows và lối tắt cần tạo."
LangString NI_FIREWALL_UI ${LANG_VIETNAMESE} "Cho phép cổng giao diện web (mạng miền và mạng riêng)"
LangString NI_FIREWALL_HTTP ${LANG_VIETNAMESE} "Cho phép cổng HTTP 80"
LangString NI_FIREWALL_HTTPS ${LANG_VIETNAMESE} "Cho phép cổng HTTPS 443"
LangString NI_DESKTOP_SHORTCUT ${LANG_VIETNAMESE} "Tạo lối tắt trên màn hình đến giao diện web"
LangString NI_STARTMENU_SHORTCUT ${LANG_VIETNAMESE} "Tạo lối tắt trong Menu Bắt đầu đến giao diện web"
LangString NI_SECTION_APP ${LANG_VIETNAMESE} "nginx ignition"
LangString NI_SHORTCUT_NAME ${LANG_VIETNAMESE} "nginx ignition"
LangString NI_UNINSTALL_SHORTCUT ${LANG_VIETNAMESE} "Gỡ cài đặt nginx ignition"
LangString NI_UNINSTALL_OPTIONS_TITLE ${LANG_VIETNAMESE} "Tùy chọn gỡ cài đặt"
LangString NI_UNINSTALL_OPTIONS_SUBTITLE ${LANG_VIETNAMESE} "Chọn những gì cần xóa khỏi máy tính này."
LangString NI_UNINSTALL_PURGE_CHECKBOX ${LANG_VIETNAMESE} "Xóa cấu hình và dữ liệu trong C:\ProgramData\nginx-ignition"
LangString NI_UNINSTALL_PURGE_HINT ${LANG_VIETNAMESE} "Để trống hộp này để giữ cấu hình và cơ sở dữ liệu cho lần cài đặt sau."
LangString NI_UNINSTALL_KEEP_DATA ${LANG_VIETNAMESE} "Đang giữ cấu hình và dữ liệu trong C:\ProgramData\nginx-ignition."
LangString NI_UPGRADE_TEXT ${LANG_VIETNAMESE} "Đã phát hiện bản cài đặt nginx ignition hiện có. Dịch vụ sẽ bị dừng trong quá trình nâng cấp. Cấu hình và dữ liệu sẽ được giữ lại."
LangString NI_ERR_ARCH_X64 ${LANG_VIETNAMESE} "Trình cài đặt này yêu cầu phiên bản Windows 64-bit."
LangString NI_ERR_ARCH_ARM64 ${LANG_VIETNAMESE} "Trình cài đặt này yêu cầu Windows trên ARM64."
LangString NI_ERR_ARCH_MISMATCH ${LANG_VIETNAMESE} "Trình cài đặt này không hỗ trợ kiến trúc bộ xử lý này. Tải xuống trình cài đặt phù hợp với kiến trúc của bạn từ trang phát hành."
LangString NI_ERR_WINVER ${LANG_VIETNAMESE} "nginx ignition yêu cầu Windows 10 hoặc Windows Server 2016 trở lên."
LangString NI_ERR_CONFIG ${LANG_VIETNAMESE} "Không thể ghi tệp cấu hình. Kiểm tra quyền của C:\ProgramData\nginx-ignition và thử lại."
LangString NI_ERR_SERVICE_DELETE ${LANG_VIETNAMESE} "Không thể dừng hoặc xóa dịch vụ nginx ignition hiện có. Hãy dừng nó thủ công và chạy lại trình cài đặt."
LangString NI_ERR_DIR ${LANG_VIETNAMESE} "Không thể tạo thư mục cài đặt."
LangString NI_ERR_FIREWALL ${LANG_VIETNAMESE} "Không thể tạo một số quy tắc Tường lửa Windows. Bạn có thể thêm chúng thủ công sau."
LangString NI_CONFIG_IMPORT_FAILED ${LANG_VIETNAMESE} "Không thể sao chép tệp cấu hình được chỉ định bằng /CONFIG. Kiểm tra rằng tệp tồn tại và thử lại."
LangString NI_DETAIL_STOP ${LANG_VIETNAMESE} "Đang dừng dịch vụ hiện có..."
LangString NI_DETAIL_CONFIG ${LANG_VIETNAMESE} "Đang ghi tệp cấu hình..."
LangString NI_DETAIL_ACL ${LANG_VIETNAMESE} "Đang đặt quyền tệp..."
LangString NI_DETAIL_EVENTLOG ${LANG_VIETNAMESE} "Đang đăng ký nguồn Nhật ký sự kiện..."
