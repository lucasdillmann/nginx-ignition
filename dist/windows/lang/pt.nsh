; Brazilian Portuguese strings for the nginx ignition installer.

LangString NI_NAME ${LANG_PORTUGUESEBR} "nginx ignition"

; Group box labels
LangString NI_GROUP_WEB ${LANG_PORTUGUESEBR} "Interface web"
LangString NI_GROUP_DATA ${LANG_PORTUGUESEBR} "Dados"
LangString NI_GROUP_NGINX ${LANG_PORTUGUESEBR} "nginx"
LangString NI_GROUP_VPN ${LANG_PORTUGUESEBR} "VPN"
LangString NI_GROUP_POSTGRES ${LANG_PORTUGUESEBR} "Conexão PostgreSQL"
LangString NI_GROUP_FIREWALL ${LANG_PORTUGUESEBR} "Firewall do Windows"
LangString NI_GROUP_SHORTCUTS ${LANG_PORTUGUESEBR} "Atalhos"
LangString NI_WELCOME_TITLE ${LANG_PORTUGUESEBR} "Bem-vindo à instalação do nginx ignition"
LangString NI_WELCOME_TEXT ${LANG_PORTUGUESEBR} "Este assistente instalará o nginx ignition e o registrará como um serviço do Windows.$\r$\n$\r$\nO nginx ignition é uma interface web moderna para gerenciar o servidor web nginx. O nginx não está incluído e deve ser instalado separadamente.$\r$\n$\r$\nClique em Avançar para continuar."
LangString NI_VERSION_LABEL ${LANG_PORTUGUESEBR} "Versão"
LangString NI_FINISH_TITLE ${LANG_PORTUGUESEBR} "Instalação concluída"
LangString NI_FINISH_TEXT ${LANG_PORTUGUESEBR} "O nginx ignition foi instalado com sucesso. Abra a interface web para criar seu primeiro usuário e concluir a configuração."
LangString NI_FINISH_RUN ${LANG_PORTUGUESEBR} "Abrir o nginx ignition"
LangString NI_FINISH_LINK ${LANG_PORTUGUESEBR} "Site do projeto"
LangString NI_INSTALLTYPE_TITLE ${LANG_PORTUGUESEBR} "Tipo de instalação"
LangString NI_INSTALLTYPE_SUBTITLE ${LANG_PORTUGUESEBR} "Escolha como deseja configurar o nginx ignition."
LangString NI_INSTALLTYPE_EXPRESS ${LANG_PORTUGUESEBR} "Expressa (recomendada)"
LangString NI_INSTALLTYPE_EXPRESS_DESC ${LANG_PORTUGUESEBR} "Usa a instalação do nginx detectada, escuta em 127.0.0.1:8090 e utiliza o banco de dados SQLite embutido (recomendado para testes) com a conta LocalSystem."
LangString NI_INSTALLTYPE_ADVANCED ${LANG_PORTUGUESEBR} "Avançada"
LangString NI_INSTALLTYPE_ADVANCED_DESC ${LANG_PORTUGUESEBR} "Permite configurar o nginx, as portas do servidor, o banco de dados, a conta do serviço e as regras de firewall."
LangString NI_NGINX_TITLE ${LANG_PORTUGUESEBR} "Configuração do nginx"
LangString NI_NGINX_SUBTITLE ${LANG_PORTUGUESEBR} "Informe onde o nginx está instalado e onde o nginx ignition deve gravar sua configuração."
LangString NI_NGINX_PATH ${LANG_PORTUGUESEBR} "Caminho do nginx.exe:"
LangString NI_BROWSE ${LANG_PORTUGUESEBR} "Procurar..."
LangString NI_FILE_FILTER ${LANG_PORTUGUESEBR} "Executáveis (*.exe)|*.exe|Todos os arquivos (*.*)|*.*"
LangString NI_NGINX_CONFIG_DIR ${LANG_PORTUGUESEBR} "Diretório de configuração gerenciada do nginx:"
LangString NI_VPN_CONFIG_DIR ${LANG_PORTUGUESEBR} "Diretório de configuração de VPN:"
LangString NI_NGINX_HINT ${LANG_PORTUGUESEBR} "O caminho do nginx.exe deve ser absoluto para que o serviço do Windows possa encontrá-lo."
LangString NI_NGINX_NOT_FOUND ${LANG_PORTUGUESEBR} "O nginx.exe não foi encontrado no caminho selecionado. O nginx ignition ainda pode ser instalado, mas você deve definir um caminho válido no arquivo de configuração antes de iniciar o serviço.$\r$\n$\r$\nContinuar mesmo assim?"
LangString NI_SERVER_TITLE ${LANG_PORTUGUESEBR} "Servidor e dados"
LangString NI_SERVER_SUBTITLE ${LANG_PORTUGUESEBR} "Configure o endereço e a porta usados pela interface web e onde os dados são armazenados."
LangString NI_SERVER_ADDRESS ${LANG_PORTUGUESEBR} "Endereço de escuta:"
LangString NI_SERVER_PORT ${LANG_PORTUGUESEBR} "Porta HTTP:"
LangString NI_SERVER_HINT ${LANG_PORTUGUESEBR} "Use 127.0.0.1 para aceitar apenas conexões locais, ou 0.0.0.0 para expor a interface web na rede."
LangString NI_DATA_DIR ${LANG_PORTUGUESEBR} "Diretório de dados:"
LangString NI_INVALID_PORT ${LANG_PORTUGUESEBR} "A porta deve ser um número entre 1 e 65535."
LangString NI_DATABASE_TITLE ${LANG_PORTUGUESEBR} "Banco de dados"
LangString NI_DATABASE_SUBTITLE ${LANG_PORTUGUESEBR} "Escolha o banco de dados usado pelo nginx ignition."
LangString NI_DB_SQLITE ${LANG_PORTUGUESEBR} "SQLite embutido (recomendado para testes)"
LangString NI_DB_POSTGRES ${LANG_PORTUGUESEBR} "PostgreSQL (recomendado para produção)"
LangString NI_DB_HOST ${LANG_PORTUGUESEBR} "Host:"
LangString NI_DB_PORT ${LANG_PORTUGUESEBR} "Porta:"
LangString NI_DB_NAME ${LANG_PORTUGUESEBR} "Nome do banco:"
LangString NI_DB_SCHEMA ${LANG_PORTUGUESEBR} "Schema:"
LangString NI_DB_USER ${LANG_PORTUGUESEBR} "Usuário:"
LangString NI_DB_PASSWORD ${LANG_PORTUGUESEBR} "Senha:"
LangString NI_DB_SSLMODE ${LANG_PORTUGUESEBR} "Modo SSL:"
LangString NI_DB_SSL_DISABLE ${LANG_PORTUGUESEBR} "Desativar"
LangString NI_DB_SSL_REQUIRE ${LANG_PORTUGUESEBR} "Exigir"
LangString NI_DB_REQUIRED ${LANG_PORTUGUESEBR} "Host, nome do banco, usuário e senha são obrigatórios para o PostgreSQL."
LangString NI_DB_CHANGE_WARNING ${LANG_PORTUGUESEBR} "Você está alterando o driver de banco de dados de uma instalação existente. Os dados não são migrados automaticamente.$\r$\n$\r$\nContinuar?"
LangString NI_SERVICE_TITLE ${LANG_PORTUGUESEBR} "Serviço do Windows"
LangString NI_SERVICE_SUBTITLE ${LANG_PORTUGUESEBR} "Escolha a conta e o modo de inicialização usados pelo serviço do nginx ignition."
LangString NI_SERVICE_ACCOUNT ${LANG_PORTUGUESEBR} "Conta do serviço"
LangString NI_SERVICE_LOCALSYSTEM ${LANG_PORTUGUESEBR} "LocalSystem (recomendado)"
LangString NI_SERVICE_NETWORKSERVICE ${LANG_PORTUGUESEBR} "Serviço de Rede"
LangString NI_SERVICE_LOCALSERVICE ${LANG_PORTUGUESEBR} "Serviço Local"
LangString NI_SERVICE_CUSTOM ${LANG_PORTUGUESEBR} "Conta personalizada"
LangString NI_SERVICE_USER ${LANG_PORTUGUESEBR} "Nome da conta:"
LangString NI_SERVICE_PASSWORD ${LANG_PORTUGUESEBR} "Senha:"
LangString NI_SERVICE_PASSWORD_CONFIRM ${LANG_PORTUGUESEBR} "Confirmar senha:"
LangString NI_SERVICE_STARTTYPE ${LANG_PORTUGUESEBR} "Tipo de inicialização"
LangString NI_SERVICE_AUTO ${LANG_PORTUGUESEBR} "Automática"
LangString NI_SERVICE_MANUAL ${LANG_PORTUGUESEBR} "Manual"
LangString NI_SERVICE_START_NOW ${LANG_PORTUGUESEBR} "Iniciar o serviço após a instalação"
LangString NI_SERVICE_CUSTOM_REQUIRED ${LANG_PORTUGUESEBR} "Informe o nome da conta e a senha da conta personalizada do serviço."
LangString NI_SERVICE_CUSTOM_SUBTITLE ${LANG_PORTUGUESEBR} "Informe as credenciais da conta que executará o serviço do nginx ignition."
LangString NI_SERVICE_CUSTOM_HINT ${LANG_PORTUGUESEBR} "O instalador concede a esta conta o direito Fazer logon como um serviço quando possível. Se o serviço não iniciar, verifique o Log de Eventos do Windows."
LangString NI_SERVICE_PASSWORD_MISMATCH ${LANG_PORTUGUESEBR} "As senhas não coincidem."
LangString NI_SERVICE_CREATE_FAILED ${LANG_PORTUGUESEBR} "Não foi possível criar o serviço do nginx ignition. Verifique o nome da conta e a senha e execute o instalador novamente.$\r$\n$\r$\nDetalhes:"
LangString NI_SERVICE_START_FAILED ${LANG_PORTUGUESEBR} "O serviço foi instalado, mas não pôde ser iniciado. Verifique o Log de Eventos do Windows para obter detalhes."
LangString NI_SERVICE_DESCRIPTION ${LANG_PORTUGUESEBR} "Serve a interface web do nginx ignition e gerencia o nginx."
LangString NI_FIREWALL_TITLE ${LANG_PORTUGUESEBR} "Firewall e atalhos"
LangString NI_FIREWALL_SUBTITLE ${LANG_PORTUGUESEBR} "Escolha quais regras do Firewall do Windows e atalhos devem ser criados."
LangString NI_FIREWALL_UI ${LANG_PORTUGUESEBR} "Permitir a porta da interface web (redes de domínio e privadas)"
LangString NI_FIREWALL_HTTP ${LANG_PORTUGUESEBR} "Permitir a porta HTTP 80"
LangString NI_FIREWALL_HTTPS ${LANG_PORTUGUESEBR} "Permitir a porta HTTPS 443"
LangString NI_DESKTOP_SHORTCUT ${LANG_PORTUGUESEBR} "Criar um atalho na área de trabalho para a interface web"
LangString NI_STARTMENU_SHORTCUT ${LANG_PORTUGUESEBR} "Criar um atalho no Menu Iniciar para a interface web"
LangString NI_SECTION_APP ${LANG_PORTUGUESEBR} "nginx ignition"
LangString NI_SHORTCUT_NAME ${LANG_PORTUGUESEBR} "nginx ignition"
LangString NI_UNINSTALL_SHORTCUT ${LANG_PORTUGUESEBR} "Desinstalar o nginx ignition"
LangString NI_UNINSTALL_OPTIONS_TITLE ${LANG_PORTUGUESEBR} "Opções de desinstalação"
LangString NI_UNINSTALL_OPTIONS_SUBTITLE ${LANG_PORTUGUESEBR} "Escolha o que deseja remover deste computador."
LangString NI_UNINSTALL_PURGE_CHECKBOX ${LANG_PORTUGUESEBR} "Excluir a configuração e os dados em C:\ProgramData\nginx-ignition"
LangString NI_UNINSTALL_PURGE_HINT ${LANG_PORTUGUESEBR} "Deixe esta opção desmarcada para manter a configuração e o banco de dados para uma instalação futura."
LangString NI_UNINSTALL_KEEP_DATA ${LANG_PORTUGUESEBR} "Mantendo a configuração e os dados em C:\ProgramData\nginx-ignition."
LangString NI_UPGRADE_TEXT ${LANG_PORTUGUESEBR} "Foi detectada uma instalação existente do nginx ignition. O serviço será interrompido durante a atualização. A configuração e os dados serão preservados."
LangString NI_ERR_ARCH_X64 ${LANG_PORTUGUESEBR} "Este instalador requer uma versão de 64 bits do Windows."
LangString NI_ERR_ARCH_ARM64 ${LANG_PORTUGUESEBR} "Este instalador requer o Windows em ARM64."
LangString NI_ERR_ARCH_MISMATCH ${LANG_PORTUGUESEBR} "Este instalador não é compatível com esta arquitetura de processador. Baixe o instalador correspondente à sua arquitetura na página de versões."
LangString NI_ERR_WINVER ${LANG_PORTUGUESEBR} "O nginx ignition requer Windows 10 ou Windows Server 2016 ou superior."
LangString NI_ERR_CONFIG ${LANG_PORTUGUESEBR} "Não foi possível gravar o arquivo de configuração. Verifique as permissões de C:\ProgramData\nginx-ignition e tente novamente."
LangString NI_ERR_SERVICE_DELETE ${LANG_PORTUGUESEBR} "Não foi possível interromper ou remover o serviço existente do nginx ignition. Interrompa-o manualmente e execute o instalador novamente."
LangString NI_ERR_DIR ${LANG_PORTUGUESEBR} "Não foi possível criar o diretório de instalação."
LangString NI_ERR_FIREWALL ${LANG_PORTUGUESEBR} "Algumas regras do Firewall do Windows não puderam ser criadas. Você pode adicioná-las manualmente depois."
LangString NI_CONFIG_IMPORT_FAILED ${LANG_PORTUGUESEBR} "Não foi possível copiar o arquivo de configuração especificado em /CONFIG. Verifique se o arquivo existe e tente novamente."
LangString NI_DETAIL_STOP ${LANG_PORTUGUESEBR} "Interrompendo o serviço existente..."
LangString NI_DETAIL_CONFIG ${LANG_PORTUGUESEBR} "Gravando o arquivo de configuração..."
LangString NI_DETAIL_ACL ${LANG_PORTUGUESEBR} "Definindo permissões de arquivo..."
LangString NI_DETAIL_EVENTLOG ${LANG_PORTUGUESEBR} "Registrando a origem do Log de Eventos..."
LangString NI_DETAIL_SERVICE ${LANG_PORTUGUESEBR} "Configurando o serviço do Windows..."
LangString NI_DETAIL_FIREWALL ${LANG_PORTUGUESEBR} "Configurando o Firewall do Windows..."
LangString NI_DETAIL_SHORTCUTS ${LANG_PORTUGUESEBR} "Criando atalhos..."
LangString NI_DETAIL_START ${LANG_PORTUGUESEBR} "Iniciando o serviço do nginx ignition..."
LangString NI_DETAIL_UNINSTALL ${LANG_PORTUGUESEBR} "Removendo o nginx ignition..."
